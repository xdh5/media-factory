{
  "mcpServers": {
    "media-factory-finance": {
      "command": "C:\\Users\\zzy\\AppData\\Local\\Programs\\Python\\Python312\\python.exe",
      "args": [
        "-m",
        "core.mcp.finance"
      ],
      "env": {
        "PYTHONPATH": "${workspaceFolder}",
        "PYTHONUTF8": "1"
      }
    },
    "media-factory-language-learning": {
      "command": "C:\\Users\\zzy\\AppData\\Local\\Programs\\Python\\Python312\\python.exe",
      "args": [
        "-m",
        "core.mcp.language_learning"
      ],
      "env": {
        "PYTHONPATH": "${workspaceFolder}",
        "PYTHONUTF8": "1"
      }
    },
    "matrixmedia": {
      "command": "node",
      "args": [
        "${workspaceFolder}/integrations/MatrixMedia/mcp/dist/index.js"
      ],
      "cwd": "${workspaceFolder}/integrations/MatrixMedia/mcp",
      "env": {
        "MATRIXMEDIA_DIR": "${workspaceFolder}/integrations/MatrixMedia",
        "MATRIXMEDIA_LOGIN_SHOW": "1"
