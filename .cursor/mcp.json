{
  "mcpServers": {
    "media-factory-finance": {
      "command": "uv",
      "args": [
        "run",
        "--project",
        "${workspaceFolder}",
        "--locked",
        "--no-editable",
        "--no-dev",
        "python",
        "-m",
        "media_factory_mcp.finance"
      ],
      "env": {
        "PYTHONSAFEPATH": "1",
        "PYTHONUTF8": "1",
        "MEDIA_FACTORY_WORKSPACE": "${workspaceFolder}",
        "PYTHONPYCACHEPREFIX": "${workspaceFolder}/cache/pycache"
      }
    },
    "media-factory-language-learning": {
