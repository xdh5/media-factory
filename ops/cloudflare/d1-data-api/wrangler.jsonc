{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "media-factory-data-api",
  "main": "src/index.mjs",
  "compatibility_date": "2025-08-21",
  "routes": [
    {
      "pattern": "media-data.cyberlab.lol",
      "custom_domain": true
    }
  ],
  "triggers": {
    "crons": ["*/5 * * * *"]
  },
  "observability": {
    "logs": {
      "enabled": true,
      "invocation_logs": true
    }
  },
  "r2_buckets": [{"binding": "STORYBOARD_IMAGES", "bucket_name": "media-factory"}],
  "vars": {"KNOWLEDGE_INDEXES": "{\"media-knowledge-v1\":{\"binding\":\"KNOWLEDGE_PRIMARY\",\"dimensions\":1024,\"metric\":\"cosine\"},\"media-knowledge-v2\":{\"binding\":\"KNOWLEDGE_SECONDARY\",\"dimensions\":1024,\"metric\":\"cosine\"}}"},
  "vectorize": [
    {"binding":"KNOWLEDGE_PRIMARY","index_name":"media-knowledge-v1"},
    {"binding":"KNOWLEDGE_SECONDARY","index_name":"media-knowledge-v2"}
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "media-factory",
      "database_id": "a9d3c3fd-9c6b-44b3-8327-a5ff8f673e32",
      "migrations_dir": "migrations"
    }
  ]
}
