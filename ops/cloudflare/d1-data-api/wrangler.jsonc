{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "media-factory-data-api",
  "main": "src/index.mjs",
  "compatibility_date": "2025-08-21",
  "routes": [
    {
      "pattern": "media-data.example.com",
      "custom_domain": true
    }
  ],
  "observability": {
    "logs": {
      "enabled": true,
      "invocation_logs": true
    }
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "media-factory",
      "database_id": "REPLACE_WITH_D1_DATABASE_ID",
      "migrations_dir": "migrations"
    }
  ]
}
