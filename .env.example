# 当前 Agent 无生图能力或连续失败三次时，使用火山方舟兜底。
VOLC_ARK_API_KEY=
VOLC_ARK_IMAGE_MODEL=doubao-seedream-4-5-251128
VOLC_ARK_IMAGE_URL=https://ark.cn-beijing.volces.com/api/v3/images/generations

# 千问文本生成。财经、语言学习和 GitHub Actions 统一使用正式版 qwen3.8-max。
DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
DASHSCOPE_MODEL=qwen3.8-max
DASHSCOPE_ENABLE_THINKING=false

# 剪辑转文字：Groq Whisper。抖音解析失败时再填浏览器 Cookie。
GROQ_API_KEY=
GROQ_ASR_MODEL=whisper-large-v3
GROQ_ASR_BASE_URL=https://api.groq.com/openai/v1
GROQ_ASR_CHUNK_SECONDS=1200
DOUYIN_COOKIE=

# YouTube / Meta 按账号前缀配置，可加多组。语言学习用 LANGUAGE_LEARNING_*；财经用 FINANCE_*。
# 语言学习：YouTube Daily Chinese Learning。access token 可空，发布时用 refresh token 换。
LANGUAGE_LEARNING_YOUTUBE_CHANNEL_ID=UC2WPS9jGyQF38pzj_j2EA5g
LANGUAGE_LEARNING_YOUTUBE_CHANNEL_TITLE=Daily Chinese Learning
LANGUAGE_LEARNING_YOUTUBE_CLIENT_ID=
LANGUAGE_LEARNING_YOUTUBE_CLIENT_SECRET=
LANGUAGE_LEARNING_YOUTUBE_REFRESH_TOKEN=
LANGUAGE_LEARNING_YOUTUBE_TOKEN=

# 语言学习：Facebook Page Reels / Instagram Reels。Instagram 用同一份 Page Token，另填专业号 user id。
LANGUAGE_LEARNING_FACEBOOK_PAGE_ID=
LANGUAGE_LEARNING_FACEBOOK_PAGE_ACCESS_TOKEN=
LANGUAGE_LEARNING_INSTAGRAM_USER_ID=

# Cloudflare R2（S3 兼容）。桶需公开读，R2_PUBLIC_BASE_URL 必须是不登录就能打开 mp4 的前缀。
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_BASE_URL=

# Cloudflare D1 统一数据入口。本地、GitHub Actions 与其他运行环境必须指向同一个 Worker。
CLOUDFLARE_DATA_API_URL=
CLOUDFLARE_DATA_API_TOKEN=
