# 当前 Agent 无生图能力或连续失败三次时，使用火山方舟兜底。
VOLC_ARK_API_KEY=
VOLC_ARK_IMAGE_MODEL=doubao-seedream-4-5-251128
VOLC_ARK_IMAGE_URL=https://ark.cn-beijing.volces.com/api/v3/images/generations

# 剪辑转文字：Groq Whisper。抖音解析失败时再填浏览器 Cookie。
GROQ_API_KEY=
GROQ_ASR_MODEL=whisper-large-v3
GROQ_ASR_BASE_URL=https://api.groq.com/openai/v1
GROQ_ASR_CHUNK_SECONDS=1200
DOUYIN_COOKIE=

# Facebook / Instagram Reels。开发模式只发自己的主页和已绑定的 Instagram 专业号。
META_APP_ID=
META_APP_SECRET=
FACEBOOK_PAGE_ID=
FACEBOOK_PAGE_ACCESS_TOKEN=
INSTAGRAM_USER_ID=
INSTAGRAM_ACCESS_TOKEN=

# Cloudflare R2（S3 兼容）。桶需公开读，R2_PUBLIC_BASE_URL 必须是不登录就能打开 mp4 的前缀。
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_BASE_URL=

# 后台任务完成通知。SQLite 存状态；wait_task 用 Redis Stream 阻塞唤醒。未启动 Redis 时 wait_task 会轮询数据库。
REDIS_URL=redis://127.0.0.1:6379/0
