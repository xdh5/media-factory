# 千问文本：由 GitHub 财经 Runner 在 MCP 外调用。
DASHSCOPE_API_KEY_FINANCE=
DASHSCOPE_API_KEY_PSYCHOLOGY_QUIZ=
DASHSCOPE_API_KEY_LANGUAGE=
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
DASHSCOPE_MODEL=qwen3.7-plus
DASHSCOPE_ENABLE_THINKING=false

# 心理测试使用的正版视频素材 API，按 Pexels、Pixabay、Coverr 顺序兜底。
PEXELS_API_KEY=
PIXABAY_API_KEY=
COVERR_API_KEY=

# 剪辑转文字：Groq Whisper。
GROQ_API_KEY=
GROQ_ASR_MODEL=whisper-large-v3
GROQ_ASR_BASE_URL=https://api.groq.com/openai/v1
GROQ_ASR_CHUNK_SECONDS=1200

# 视频下载：微信视频号需要腾讯元宝 Cookie（浏览器登录 yuanbao.tencent.com 后从请求头复制）。
SPH_COOKIE=

# 动漫宿主启动 GitHub Action：需要目标仓库 Actions 写权限；本机也可复用 gh 登录。
ANIME_GITHUB_TOKEN=

# 抖音作者作品列表与作品详情：Cookie 只放在 integrations/media-collector/.env 的 DY_COOKIES（须含 UIFID），本文件不再配置。

# YouTube 的 OAuth 客户端全项目共用；频道 ID 与 refresh token 按账号前缀配置。
# 语言学习：YouTube Daily Chinese Learning。access token 可空，发布时用 refresh token 换。
LANGUAGE_LEARNING_YOUTUBE_CHANNEL_ID=
LANGUAGE_LEARNING_YOUTUBE_CHANNEL_TITLE=
LANGUAGE_LEARNING_YOUTUBE_REFRESH_TOKEN=
LANGUAGE_LEARNING_YOUTUBE_TOKEN=
YOUTUBE_OAUTH_CLIENT_ID=
YOUTUBE_OAUTH_CLIENT_SECRET=
# YouTube 超时后切换的 Clash HTTP 代理；留空禁用兜底。
# 未设置时本机默认 http://127.0.0.1:7897，Docker 默认 http://host.docker.internal:7897。
# YOUTUBE_FALLBACK_PROXY=http://127.0.0.1:7897

# Zernio TikTok：API key 全项目共用，账号 ID 按业务频道隔离。
ZERNIO_API_KEY=
LANGUAGE_LEARNING_TIKTOK_ACCOUNT_ID=
LANGUAGE_LEARNING_TIKTOK_ACCOUNT_TITLE=Daily Chinese
LANGUAGE_LEARNING_TIKTOK_USERNAME=

# Zernio Meta：Facebook 与 Instagram 共用专用 key；平台只连接一个健康账号时 ID 可空。
zernio_api_key_meta=
LANGUAGE_LEARNING_FACEBOOK_ACCOUNT_ID=
LANGUAGE_LEARNING_INSTAGRAM_ACCOUNT_ID=

# Cloudflare R2（S3 兼容）。桶需公开读，R2_PUBLIC_BASE_URL 必须是不登录就能打开 mp4 的前缀。
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_BASE_URL=

# Cloudflare D1 统一数据入口。本地、GitHub Actions 与其他运行环境必须指向同一个 Worker。
CLOUDFLARE_DATA_API_URL=
CLOUDFLARE_DATA_API_TOKEN=

# LangSmith：启用后上传脱敏任务、模型和工具链路；密钥从 LangSmith 设置页取得。
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=media-factory
LANGSMITH_ENDPOINT=https://apac.api.smith.langchain.com
