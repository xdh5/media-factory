# MatrixMedia 是 Windows Electron 客户端，不进 Docker 镜像
integrations/MatrixMedia/

# 版本库与本地产物，不进镜像
.git
.gitignore
.env
**/__pycache__
**/*.pyc
tmp_audio/
tmp_*.py
data/*/cache/
data/*/outputs/
data/youtube/tokens/
**/*.db
**/*.sqlite
**/*.sqlite3

# 输出产物（音效 wav 在 core/capabilities/intro/static/，不在此列，会进镜像）
*.mp3
!core/capabilities/bgm/static/*.mp3
*.mp4
