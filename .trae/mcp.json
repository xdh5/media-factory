{
  "mcpServers": {
    "media-factory-finance": {
      "command": "python",
      "args": [
        "-m",
        "core.mcp.finance"
      ],
      "env": {
        "PYTHONPATH": "${workspaceFolder}",
        "PYTHONUTF8": "1",
        "DASHSCOPE_BUSINESS_LINE": "finance"
      },
      "enabled": true
    },
    "media-factory-language-learning": {
      "command": "python",
      "args": [
        "-m",
        "core.mcp.language_learning"
      ],
      "env": {
        "PYTHONPATH": "${workspaceFolder}",
        "PYTHONUTF8": "1",
        "DASHSCOPE_BUSINESS_LINE": "language_learning"
      },
      "enabled": true
    },
    "media-factory-publishing": {
      "command": "python",
      "args": [
        "-m",
        "core.mcp.publishing"
      ],
      "env": {
        "PYTHONPATH": "${workspaceFolder}",
        "PYTHONUTF8": "1"
      },
      "enabled": true
    },
    "media-factory-douyin-research": {
      "command": "python",
      "args": [
        "-m",
        "core.mcp.douyin_research"
      ],
      "env": {
        "PYTHONPATH": "${workspaceFolder}",
        "PYTHONUTF8": "1"
      },
      "enabled": true
    }
  }
}
